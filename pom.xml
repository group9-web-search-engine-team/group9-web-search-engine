<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.group9.websearch</groupId>
    <artifactId>crawler-mvp</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>Crawler MVP</name>
    <description>StormCrawler + S3 raw HTML + PostgreSQL frontier/metadata/graph vertical slice</description>

    <!--
      Pinned, verified-compatible versions (design.md "Verified and pinned versions").
      - Apache StormCrawler 3.x (group org.apache.stormcrawler) targets the Storm 2.x runtime.
      - Apache Storm 2.8.x requires Java 17+.
      - Java toolchain: Java 17 LTS (Requirement 14.3). JDK 24 is NOT a supported target.
      - PostgreSQL JDBC driver 42.x line.
      - AWS SDK for Java v2 (standard credential provider chain, configurable region).
    -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <stormcrawler.version>3.1.0</stormcrawler.version>
        <!-- StormCrawler 3.1.0 pins storm-client to 2.6.4 in its parent POM; match it. -->
        <storm.version>2.6.4</storm.version>
        <!--
          Week 3 distributed SPIMI indexer. Matches the Hadoop 3.5.0 runtime installed in
          WSL2 exactly (verified against Maven Central). Hadoop jars are 'provided' scope:
          they are needed to compile the MapReduce classes but the Hadoop/YARN runtime
          supplies them at execution time, so they are NOT bundled into the indexer jar.
        -->
        <hadoop.version>3.5.0</hadoop.version>
        <!-- jsoup is used by the exporter for HTML text extraction. Was transitive via
             StormCrawler; pin it explicitly so the indexer artifact (which does not depend
             on StormCrawler) still has it. -->
        <jsoup.version>1.18.1</jsoup.version>
        <aws.sdk.version>2.28.29</aws.sdk.version>
        <postgresql.version>42.7.4</postgresql.version>
        <jackson.version>2.18.2</jackson.version>
        <slf4j.version>2.0.16</slf4j.version>
        <logback.version>1.5.12</logback.version>

        <junit.version>5.11.3</junit.version>
        <jqwik.version>1.9.1</jqwik.version>
        <mockito.version>5.14.2</mockito.version>
        <testcontainers.version>1.20.4</testcontainers.version>

        <surefire.version>3.5.2</surefire.version>
    </properties>

    <dependencies>
        <!-- Apache StormCrawler core (native spouts/bolts: Fetcher, Parser, URLPartitioner, URL filters) -->
        <dependency>
            <groupId>org.apache.stormcrawler</groupId>
            <artifactId>stormcrawler-core</artifactId>
            <version>${stormcrawler.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.storm</groupId>
                    <artifactId>storm-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Apache Storm runtime (local mode for the bounded MVP crawl) -->
        <dependency>
            <groupId>org.apache.storm</groupId>
            <artifactId>storm-client</artifactId>
            <version>${storm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.storm</groupId>
            <artifactId>storm-server</artifactId>
            <version>${storm.version}</version>
        </dependency>

        <!-- AWS SDK v2 - S3 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${aws.sdk.version}</version>
        </dependency>

        <!-- PostgreSQL JDBC driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>

        <!-- jsoup HTML parsing. Explicit (was transitive via StormCrawler) so the exporter
             and the standalone indexer artifact both resolve it deterministically. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>

        <!-- ===== Week 3 Hadoop MapReduce (provided: supplied by the YARN runtime) ===== -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client</artifactId>
            <version>${hadoop.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSON config / jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- ===== Test dependencies ===== -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Lets MapReduce mapper/reducer logic run in-process via the LocalJobRunner for
             tests (no live YARN cluster needed). Test scope only. -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-mapreduce-client-jobclient</artifactId>
            <version>${hadoop.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>crawler-mvp</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Properties.java</include>
                    </includes>
                    <!-- Integration tests requiring external services are opt-in via -DrunIntegration=true -->
                    <excludedGroups>integration</excludedGroups>
                </configuration>
            </plugin>

            <!-- Fat jar for Storm local-mode runner -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>crawler-shade</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.group9.websearch.crawler.CrawlerTopologyRunner</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Week 3 indexer artifact. Activate with:  .\mvnw.cmd -Pindexer clean package
          This adds a SECOND shade execution that produces target/indexer.jar with mainClass
          IndexerCli. It is additive: the default crawler shade (crawler-mvp.jar) is untouched,
          so the crawler remains independently buildable and runnable.

          Hadoop classes are 'provided', so they are deliberately NOT bundled; the jar is run
          with `hadoop jar` / `yarn jar`, which supply the Hadoop runtime on the classpath.
          AWS SDK, jackson, postgres, jsoup, slf4j ARE bundled (the exporter needs them and
          Hadoop does not provide them).
        -->
        <profile>
            <id>indexer</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <!--
                              Skip the crawler fat-jar shade during an indexer build so the
                              indexer execution shades the plain compiled jar (not the 170MB
                              crawler uber-jar). The crawler-shade config is left intact; it
                              simply does not run under -Pindexer. A normal `mvn package`
                              (no profile) still produces crawler-mvp.jar unchanged.
                            -->
                            <execution>
                                <id>crawler-shade</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>indexer-shade</id>
                                <phase>package</phase>
                                <goals><goal>shade</goal></goals>
                                <configuration>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <!-- Produce target/indexer.jar (the crawler shade is
                                         skipped under this profile, so nothing is overwritten). -->
                                    <finalName>indexer</finalName>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>com.group9.websearch.index.IndexerCli</mainClass>
                                        </transformer>
                                    </transformers>
                                    <artifactSet>
                                        <!--
                                          The indexer only needs the exporter + MapReduce job
                                          dependencies (AWS S3, jackson, postgres, jsoup, slf4j
                                          and their transitive deps). Storm, StormCrawler,
                                          Selenium, Tika etc. belong only to the crawler and
                                          must NOT be bundled here (they would bloat the jar to
                                          ~170MB and clash with the Hadoop runtime classpath).
                                          Hadoop itself is 'provided' so it is excluded anyway.
                                        -->
                                        <excludes>
                                            <exclude>org.apache.storm:*</exclude>
                                            <exclude>org.apache.stormcrawler:*</exclude>
                                            <exclude>org.seleniumhq.selenium:*</exclude>
                                            <exclude>org.apache.tika:*</exclude>
                                            <exclude>com.rometools:*</exclude>
                                            <exclude>xerces:*</exclude>
                                            <exclude>com.github.crawler-commons:*</exclude>
                                            <exclude>io.dropwizard.metrics:*</exclude>
                                            <exclude>com.esotericsoftware:*</exclude>
                                            <exclude>io.netty:*</exclude>
                                            <exclude>io.opentelemetry:*</exclude>
                                            <!--
                                              Logging: the Hadoop/YARN runtime supplies its own
                                              SLF4J binding (reload4j). Bundling logback-classic
                                              AND the log4j-over-slf4j bridge causes SLF4J's
                                              log4j delegation loop (StackOverflowError) in the
                                              YARN container. Exclude them; keep only slf4j-api
                                              (also provided by Hadoop, harmless if duplicated).
                                            -->
                                            <exclude>ch.qos.logback:*</exclude>
                                            <exclude>org.slf4j:log4j-over-slf4j</exclude>
                                            <exclude>org.slf4j:slf4j-api</exclude>
                                            <!-- log4j2 + its SLF4J binding (StaticLoggerBinder,
                                                 Log4jLoggerFactory) also conflict with Hadoop's
                                                 reload4j binding; drop the whole log4j2 family. -->
                                            <exclude>org.apache.logging.log4j:*</exclude>
                                        </excludes>
                                    </artifactSet>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                                <!-- Logging config/bindings belong to the
                                                     crawler, not the Hadoop-hosted indexer.
                                                     Keeping logback.xml or any org/slf4j/impl
                                                     binding reintroduces the SLF4J conflict in
                                                     the YARN container. -->
                                                <exclude>logback.xml</exclude>
                                                <exclude>logback-*.xml</exclude>
                                                <exclude>org/slf4j/impl/**</exclude>
                                                <exclude>org/apache/logging/slf4j/**</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>search</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>crawler-shade</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>search-shade</id>
                                <phase>package</phase>
                                <goals><goal>shade</goal></goals>
                                <configuration>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <finalName>search</finalName>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>com.group9.websearch.search.SearchCli</mainClass>
                                        </transformer>
                                    </transformers>
                                    <artifactSet>
                                        <excludes>
                                            <exclude>org.apache.storm:*</exclude>
                                            <exclude>org.apache.stormcrawler:*</exclude>
                                            <exclude>org.seleniumhq.selenium:*</exclude>
                                            <exclude>org.apache.tika:*</exclude>
                                            <exclude>com.rometools:*</exclude>
                                            <exclude>xerces:*</exclude>
                                            <exclude>com.github.crawler-commons:*</exclude>
                                            <exclude>io.dropwizard.metrics:*</exclude>
                                            <exclude>com.esotericsoftware:*</exclude>
                                            <exclude>io.netty:*</exclude>
                                            <exclude>io.opentelemetry:*</exclude>
                                            <exclude>software.amazon.awssdk:*</exclude>
                                            <exclude>org.apache.hadoop:*</exclude>
                                            <exclude>org.postgresql:*</exclude>
                                            <exclude>org.apache.logging.log4j:*</exclude>
                                        </excludes>
                                    </artifactSet>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Evaluation CLI artifact. Activate with:  .\mvnw.cmd -Peval clean package
          Produces target/eval.jar with mainClass EvalCli. Same dependency footprint as the
          search profile (it drives the existing BM25 SearchService over a fixed index snapshot
          and reads benchmark queries/qrels via jackson). Additive; skips the crawler fat-jar
          shade so it shades the plain compiled jar. No Hadoop/Storm/AWS/Postgres bundled.
        -->
        <profile>
            <id>eval</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>crawler-shade</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>eval-shade</id>
                                <phase>package</phase>
                                <goals><goal>shade</goal></goals>
                                <configuration>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <finalName>eval</finalName>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>com.group9.websearch.eval.EvalCli</mainClass>
                                        </transformer>
                                    </transformers>
                                    <artifactSet>
                                        <excludes>
                                            <exclude>org.apache.storm:*</exclude>
                                            <exclude>org.apache.stormcrawler:*</exclude>
                                            <exclude>org.seleniumhq.selenium:*</exclude>
                                            <exclude>org.apache.tika:*</exclude>
                                            <exclude>com.rometools:*</exclude>
                                            <exclude>xerces:*</exclude>
                                            <exclude>com.github.crawler-commons:*</exclude>
                                            <exclude>io.dropwizard.metrics:*</exclude>
                                            <exclude>com.esotericsoftware:*</exclude>
                                            <exclude>io.netty:*</exclude>
                                            <exclude>io.opentelemetry:*</exclude>
                                            <exclude>software.amazon.awssdk:*</exclude>
                                            <exclude>org.apache.hadoop:*</exclude>
                                            <exclude>org.postgresql:*</exclude>
                                            <exclude>org.apache.logging.log4j:*</exclude>
                                        </excludes>
                                    </artifactSet>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
